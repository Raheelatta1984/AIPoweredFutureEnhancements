# ---------------------------------------------------------------------------
# AI-Powered Future Enhancements — configuration
# Copy to .env and fill in. Nothing here is required for `npm run dev` except
# the two secrets you would want in production.
# ---------------------------------------------------------------------------

# HMAC key for the self-contained feh_session cookie. Use 32+ random characters.
# A dev-only fallback is used when this is missing (never do that in production).
SESSION_SECRET=

# SQLite file. Defaults to data/enhancements.db (or /tmp on serverless, flagged
# as ephemeral in the UI).
DATABASE_FILE=

# Where the Markdown vault lives. Defaults to ./vault and is committed to git.
ENHANCEMENT_VAULT_DIR=

# Where the local handover mirror lives. Defaults to ./handovers (committed).
ENHANCEMENT_HANDOVER_DIR=

# GitHub token with contents:write on every tenant's github_repo. Without it,
# moving a proposal to Building is refused (visibly) rather than faked.
#
# This is optional now: an admin can paste a token on /tenants instead, where it is
# encrypted at rest with a key derived from SESSION_SECRET. When both exist, this
# variable wins (so infrastructure can always override what the UI stored).
GITHUB_TOKEN=

# Optional: override the branch handovers are published to (default: main).
GITHUB_DEFAULT_BRANCH=

# Optional: GitHub API base. Only needed for GitHub Enterprise
# (e.g. https://ghe.example.com/api/v3) or for pointing tests at a fake server.
GITHUB_API_URL=

# Seed the two demo tenants, six demo people and four proposals. Set to false
# for a clean production hub.
SEED_DEMO_DATA=true

# Reconcile repo-side handover documents at server start. Set to false to skip.
ENHANCEMENT_DOC_SYNC=true

# ---------------------------------------------------------------------------
# Deploying to Vercel (or any serverless host)
#
# vercel.json pins framework: nextjs. Without it the project is inferred as a
# static site and the build fails with STATIC_BUILD_NO_OUT_DIR.
#
# A serverless filesystem is read-only except /tmp, so the database, the vault
# and the handover mirror default to /tmp/enhancements/* there. With no
# DATABASE_FILE the hub boots, migrates and seeds itself on the first request,
# but that state is thrown away on every cold start: the top bar says so
# ("ephemeral /tmp"), and the same applies to a missing SESSION_SECRET
# ("dev session secret") or GITHUB_TOKEN ("publishing off").
#
# For durable content, point these at mounted/persistent storage:
#   DATABASE_FILE, ENHANCEMENT_VAULT_DIR, ENHANCEMENT_HANDOVER_DIR
# ---------------------------------------------------------------------------

# Optional: scan a local checkout instead of the GitHub API (offline / CI use).
# Layout: <HANDOVER_SCAN_ROOT>/<repo-name>/<handover_dir>/*.md
HANDOVER_SCAN_ROOT=

# Drafting is local and deterministic. This documents the fact; no provider is
# ever called and proposal text never leaves the server.
AI_PROVIDER=local
