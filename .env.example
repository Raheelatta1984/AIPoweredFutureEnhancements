# ---------------------------------------------------------------------------
# AI-Powered Future Enhancements — configuration
# Copy to .env and fill in. Nothing here is required for `npm run dev` except
# the two secrets you would want in production.
# ---------------------------------------------------------------------------

# HMAC key for the self-contained feh_session cookie. Use 32+ random characters.
# A dev-only fallback is used when this is missing (never do that in production).
SESSION_SECRET=

# SQLite file. Defaults to data/enhancements.db (or /tmp on serverless, flagged
# as ephemeral in the UI).
DATABASE_FILE=

# Where the Markdown vault lives. Defaults to ./vault and is committed to git.
ENHANCEMENT_VAULT_DIR=

# GitHub token with contents:write on every tenant's github_repo. Without it,
# moving a proposal to Building is refused (visibly) rather than faked.
GITHUB_TOKEN=

# Optional: override the branch handovers are published to (default: main).
GITHUB_DEFAULT_BRANCH=

# Seed the two demo tenants, six demo people and four proposals. Set to false
# for a clean production hub.
SEED_DEMO_DATA=true

# Reconcile repo-side handover documents at server start. Set to false to skip.
ENHANCEMENT_DOC_SYNC=true

# Optional: scan a local checkout instead of the GitHub API (offline / CI use).
# Layout: <HANDOVER_SCAN_ROOT>/<repo-name>/<handover_dir>/*.md
HANDOVER_SCAN_ROOT=

# Drafting is local and deterministic. This documents the fact; no provider is
# ever called and proposal text never leaves the server.
AI_PROVIDER=local
